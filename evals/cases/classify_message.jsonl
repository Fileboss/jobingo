// Fictional messages, labelled by hand. Every domain is .example. `rec-06`, a salary
// proposal on an application under way, is `recruiter_other` on purpose: filed as
// `offer`, it would create a second offer for a job already applied to.
{"id": "offer-01", "from_addr": "Julie Perrin <julie.perrin@talentfinder.example>", "subject": "Poste d'ingénieur data à Lyon", "body_text": "Bonjour,\n\nJe recrute pour un éditeur SaaS lyonnais un ingénieur data en CDI (Python, Airflow, PostgreSQL). Salaire 58-65 k€, télétravail deux jours par semaine. Seriez-vous ouvert à en discuter ?\n\nJulie Perrin, TalentFinder", "expected": {"category": "offer"}}
{"id": "offer-02", "from_addr": "jobs@welcomejobs.example", "subject": "Nouvelle offre : Développeur backend Python H/F", "body_text": "Une offre correspond à votre profil.\n\nDéveloppeur backend Python H/F — Kiosque Numérique — Villeurbanne\nCDI, 50 à 60 k€.\nMissions : concevoir les API de la plateforme de réservation, améliorer la qualité du code.\n\nVoir l'offre", "expected": {"category": "offer"}}
{"id": "offer-03", "from_addr": "Marc Olivier <m.olivier@hexaflow.example>", "subject": "Opportunité chez Hexaflow", "body_text": "Bonjour, j'ai vu votre profil. Chez Hexaflow nous ouvrons un poste de Staff Engineer sur notre moteur d'ingestion (Go et Python), full remote en France, 75 k€. Voici la fiche de poste en pièce jointe. Intéressé ?", "expected": {"category": "offer"}}
{"id": "offer-04", "from_addr": "recrutement@maisonverte.example", "subject": "Candidature spontanée — nous avons un poste pour vous", "body_text": "Suite à votre candidature spontanée de l'an dernier, nous vous informons qu'un poste d'ingénieur logiciel backend s'ouvre dans notre équipe énergie à Lyon (CDI, démarrage janvier). Le descriptif est ci-dessous : API de pilotage de bornes, Python, Kubernetes.", "expected": {"category": "offer"}}
{"id": "offer-05", "from_addr": "Sophie <sophie@cabinet-rh-alto.example>", "subject": "Mission freelance 6 mois — Data engineer", "body_text": "Bonjour, je cherche un data engineer freelance pour une mission de six mois chez un assureur à Lyon, TJM 550 €, démarrage novembre. Stack : Airflow, dbt, Snowflake. Disponible ?", "expected": {"category": "offer"}}
{"id": "offer-06", "from_addr": "noreply@indeed.example", "subject": "3 nouveaux emplois pour « ingénieur backend »", "body_text": "Ingénieur backend senior — Stratus — Lyon — CDI\nDéveloppeur Python — Agrimetrics — Télétravail\nIngénieur plateforme — Voltéo — Grenoble\n\nVoir tous les emplois", "expected": {"category": "offer"}}
{"id": "offer-07", "from_addr": "Thomas Girard <thomas@lumen-analytics.example>", "subject": "Re: votre profil GitHub", "body_text": "Bonjour, nous sommes une équipe de 12 personnes et nous cherchons notre premier ingénieur plateforme data. CDI à Lyon ou remote, 60-70 k€ + BSPCE. Je vous envoie la description complète si le sujet vous parle.", "expected": {"category": "offer"}}
{"id": "offer-08", "from_addr": "careers@banque-rhone.example", "subject": "Offre d'emploi réf. 2026-114", "body_text": "Madame, Monsieur,\nNous avons le plaisir de vous transmettre notre offre réf. 2026-114 : Développeur Java/Python, direction des systèmes d'information, CDI, Lyon Part-Dieu. Rémunération selon profil. Postulez avant le 15 octobre.", "expected": {"category": "offer"}}
{"id": "offer-09", "from_addr": "Nina Faure <nina.faure@octant-conseil.example>", "subject": "Poste en régie chez un grand compte", "body_text": "Bonjour, dans le cadre d'une prestation en régie chez un grand compte industriel, je recherche un développeur Python confirmé, CDI chez Octant Conseil, 48 k€. Pouvons-nous échanger ?", "expected": {"category": "offer"}}
{"id": "offer-10", "from_addr": "hello@welcometothejungle.example", "subject": "Ces entreprises recrutent des profils comme le vôtre", "body_text": "Data Engineer — Plume Énergie — Lyon, CDI, 55-62 k€. Plume Énergie développe une plateforme de suivi de consommation pour les collectivités. Découvrir l'offre.", "expected": {"category": "offer"}}
{"id": "rej-01", "from_addr": "Recrutement Stratus <jobs@stratus.example>", "subject": "Votre candidature — Ingénieur backend senior", "body_text": "Bonjour,\n\nNous vous remercions de l'intérêt que vous portez à Stratus. Après étude attentive de votre dossier, nous avons le regret de vous informer que nous ne donnerons pas suite à votre candidature.\n\nBien cordialement,\nL'équipe recrutement", "expected": {"category": "rejection"}}
{"id": "rej-02", "from_addr": "Claire Dumas <claire.dumas@kiosque-numerique.example>", "subject": "Re: Entretien de mardi", "body_text": "Bonjour,\n\nMerci encore pour votre temps mardi. L'équipe a beaucoup apprécié l'échange, mais nous avons finalement retenu un profil plus orienté front-end. Je vous souhaite bonne chance dans vos recherches.\n\nClaire", "expected": {"category": "rejection"}}
{"id": "rej-03", "from_addr": "no-reply@smartrecruiters.example", "subject": "Mise à jour de votre candidature chez Voltéo", "body_text": "Bonjour,\nLe poste d'ingénieur plateforme auquel vous avez postulé a été pourvu. Votre candidature ne sera donc pas retenue. Nous conservons votre profil pour de futures opportunités.", "expected": {"category": "rejection"}}
{"id": "rej-04", "from_addr": "rh@agrimetrics.example", "subject": "Candidature Développeur Python", "body_text": "Bonjour, nous avons bien reçu votre candidature et vous en remercions. Malheureusement, votre profil ne correspond pas aux besoins actuels de l'équipe. Nous vous souhaitons pleine réussite.", "expected": {"category": "rejection"}}
{"id": "rej-05", "from_addr": "Paul Bernard <paul@hexaflow.example>", "subject": "Suite de notre échange", "body_text": "Bonjour, je reviens vers vous après le test technique. Vous avez fait du bon travail sur la partie API, mais nous cherchons quelqu'un de plus expérimenté en Go pour ce poste. Nous ne poursuivrons pas le processus. Merci pour le temps investi.", "expected": {"category": "rejection"}}
{"id": "rej-06", "from_addr": "talent@lumen-analytics.example", "subject": "Poste d'ingénieur plateforme — mise en pause", "body_text": "Bonjour, nous avons décidé de geler le recrutement sur ce poste jusqu'à l'année prochaine, faute de budget. Nous clôturons donc les candidatures en cours, dont la vôtre. Nous sommes désolés de ce contretemps.", "expected": {"category": "rejection"}}
{"id": "rej-07", "from_addr": "jobs@banque-rhone.example", "subject": "Réf. 2026-114 — réponse à votre candidature", "body_text": "Madame, Monsieur, nous accusons réception de votre candidature. Après examen, nous sommes au regret de ne pouvoir y donner une suite favorable. Veuillez agréer nos salutations distinguées.", "expected": {"category": "rejection"}}
{"id": "rej-08", "from_addr": "Emma Roux <emma.roux@plume-energie.example>", "subject": "Merci pour votre candidature", "body_text": "Bonjour,\nMerci d'avoir pris le temps de rencontrer l'équipe. C'était un plaisir. Nous avons décidé de poursuivre avec un autre candidat dont l'expérience en énergie était plus directe. N'hésitez pas à postuler de nouveau à l'avenir !", "expected": {"category": "rejection"}}
{"id": "rej-09", "from_addr": "noreply@workable.example", "subject": "Votre candidature chez Nordvik", "body_text": "Hello,\nThank you for applying to the Backend Engineer role at Nordvik. We have decided to move forward with other candidates whose experience more closely matches our needs. We wish you the best.", "expected": {"category": "rejection"}}
{"id": "rej-10", "from_addr": "Luc Martin <luc.martin@maisonverte.example>", "subject": "Re: poste d'ingénieur logiciel", "body_text": "Bonjour, je suis navré de vous l'apprendre par écrit : la direction a finalement choisi une promotion interne pour ce poste. Votre candidature était pourtant très solide.", "expected": {"category": "rejection"}}
{"id": "rej-11", "from_addr": "recrutement@stratus.example", "subject": "Votre profil", "body_text": "Bonjour, votre profil est intéressant mais le poste exige une présence cinq jours par semaine sur site à Paris, ce qui ne correspond pas à vos attentes. Nous préférons donc ne pas aller plus loin.", "expected": {"category": "rejection"}}
{"id": "int-01", "from_addr": "Claire Dumas <claire.dumas@kiosque-numerique.example>", "subject": "Entretien — Développeur backend", "body_text": "Bonjour,\n\nVotre candidature a retenu notre attention. Seriez-vous disponible pour un entretien en visio le mardi 6 octobre 2026 à 14 h ? Le lien suivra.\n\nClaire Dumas", "expected": {"category": "interview", "interview_date": "2026-10-06"}}
{"id": "int-02", "from_addr": "Paul Bernard <paul@hexaflow.example>", "subject": "Prochaine étape", "body_text": "Bonjour, merci pour ce premier échange. La prochaine étape est un entretien technique de 90 minutes avec deux ingénieurs de l'équipe. Pouvez-vous m'indiquer vos disponibilités la semaine prochaine ?", "expected": {"category": "interview", "interview_date": null}}
{"id": "int-03", "from_addr": "no-reply@calendly.example", "subject": "Confirmé : Entretien avec Plume Énergie", "body_text": "Votre rendez-vous est confirmé.\nÉvénement : Entretien RH — Plume Énergie\nDate : jeudi 8 octobre 2026, 10:00 – 10:45 (Europe/Paris)\nLieu : Google Meet", "expected": {"category": "interview", "interview_date": "2026-10-08"}}
{"id": "int-04", "from_addr": "Julie Perrin <julie.perrin@talentfinder.example>", "subject": "Rencontre avec mon client", "body_text": "Bonjour, mon client souhaite vous rencontrer dans ses locaux de la Part-Dieu le vendredi 9 octobre 2026 à 9 h 30. Je vous confirme l'adresse d'ici demain. Cela vous convient-il ?", "expected": {"category": "interview", "interview_date": "2026-10-09"}}
{"id": "int-05", "from_addr": "talent@lumen-analytics.example", "subject": "Appel de découverte", "body_text": "Bonjour ! Merci pour votre candidature. Nous aimerions organiser un premier appel de 30 minutes pour faire connaissance. Réservez un créneau qui vous arrange via ce lien : https://cal.example/lumen", "expected": {"category": "interview", "interview_date": null}}
{"id": "int-06", "from_addr": "Emma Roux <emma.roux@plume-energie.example>", "subject": "Entretien final avec la CTO", "body_text": "Bonjour, bonne nouvelle : vous êtes invité à un dernier entretien avec notre CTO, le lundi 5 octobre 2026 à 17 h, dans nos locaux. Merci de confirmer votre présence.", "expected": {"category": "interview", "interview_date": "2026-10-05"}}
{"id": "int-07", "from_addr": "jobs@stratus.example", "subject": "Test technique", "body_text": "Bonjour, suite à notre échange téléphonique, nous vous proposons de passer à l'étape du test technique, suivi d'un entretien de restitution avec l'équipe. Quand seriez-vous disponible ?", "expected": {"category": "interview", "interview_date": null}}
{"id": "int-08", "from_addr": "Luc Martin <luc.martin@maisonverte.example>", "subject": "Re: poste d'ingénieur logiciel", "body_text": "Bonjour, je vous confirme notre rendez-vous de mercredi prochain à 11 h. À bientôt.", "expected": {"category": "interview", "interview_date": null}}
{"id": "int-09", "from_addr": "Marc Olivier <m.olivier@hexaflow.example>", "subject": "Invitation : entretien d'équipe", "body_text": "Bonjour, l'équipe aimerait vous rencontrer en visioconférence le mardi 13 octobre 2026 de 15 h à 16 h. Vous recevrez une invitation dans votre agenda.", "expected": {"category": "interview", "interview_date": "2026-10-13"}}
{"id": "int-10", "from_addr": "Sophie <sophie@cabinet-rh-alto.example>", "subject": "Présentation au client", "body_text": "Bonjour, le client a validé votre profil et souhaite un échange rapide avec vous, sans doute en fin de semaine. Je reviens vers vous avec un horaire précis.", "expected": {"category": "interview", "interview_date": null}}
{"id": "int-11", "from_addr": "no-reply@teams.example", "subject": "Entretien reporté", "body_text": "Votre entretien avec Voltéo initialement prévu le 1er octobre est reporté au mercredi 7 octobre 2026 à 16 h. Merci de mettre à jour votre agenda.", "expected": {"category": "interview", "interview_date": "2026-10-07"}}
{"id": "rec-01", "from_addr": "Julie Perrin <julie.perrin@talentfinder.example>", "subject": "Petite question", "body_text": "Bonjour, avant de vous présenter des postes, pourriez-vous me préciser vos prétentions salariales et votre préavis actuel ?", "expected": {"category": "recruiter_other"}}
{"id": "rec-02", "from_addr": "rh@kiosque-numerique.example", "subject": "Documents manquants", "body_text": "Bonjour, pour finaliser votre dossier, merci de nous transmettre une copie de votre diplôme et deux références professionnelles.", "expected": {"category": "recruiter_other"}}
{"id": "rec-03", "from_addr": "Nina Faure <nina.faure@octant-conseil.example>", "subject": "Prise de contact", "body_text": "Bonjour, je suis consultante chez Octant Conseil et j'accompagne des profils backend sur Lyon. Je n'ai pas de poste précis à vous proposer aujourd'hui, mais j'aimerais mieux connaître votre projet. Un café la semaine prochaine ?", "expected": {"category": "recruiter_other"}}
{"id": "rec-04", "from_addr": "Paul Bernard <paul@hexaflow.example>", "subject": "Re: Prochaine étape", "body_text": "Merci pour vos disponibilités. Avant de caler l'entretien, pouvez-vous me confirmer que vous êtes à l'aise avec des astreintes une semaine sur six ?", "expected": {"category": "recruiter_other"}}
{"id": "rec-05", "from_addr": "talent@lumen-analytics.example", "subject": "Accusé de réception", "body_text": "Bonjour, nous avons bien reçu votre candidature au poste d'ingénieur plateforme. Notre équipe l'étudie et reviendra vers vous sous deux semaines.", "expected": {"category": "recruiter_other"}}
{"id": "rec-06", "from_addr": "Emma Roux <emma.roux@plume-energie.example>", "subject": "Offre salariale", "body_text": "Bonjour, suite à vos entretiens, j'ai le plaisir de vous faire une proposition : 62 k€ brut annuel, deux jours de télétravail, démarrage au 1er décembre. Le contrat suivra si vous acceptez.", "expected": {"category": "recruiter_other"}}
{"id": "rec-07", "from_addr": "Claire Dumas <claire.dumas@kiosque-numerique.example>", "subject": "Retour sur l'entretien", "body_text": "Bonjour, merci pour l'entretien d'hier. Nous rencontrons encore deux candidats cette semaine et nous reviendrons vers vous d'ici vendredi.", "expected": {"category": "recruiter_other"}}
{"id": "rec-08", "from_addr": "rh@banque-rhone.example", "subject": "Questionnaire de pré-qualification", "body_text": "Madame, Monsieur, merci de compléter le questionnaire en ligne ci-joint (15 minutes) afin que nous puissions poursuivre l'étude de votre candidature.", "expected": {"category": "recruiter_other"}}
{"id": "rec-09", "from_addr": "Sophie <sophie@cabinet-rh-alto.example>", "subject": "Votre CV", "body_text": "Bonjour, pourriez-vous m'envoyer une version à jour de votre CV au format Word ? Mon client ne lit pas les PDF.", "expected": {"category": "recruiter_other"}}
{"id": "oth-01", "from_addr": "newsletter@lesjeudis.example", "subject": "Les 10 langages les plus demandés en 2026", "body_text": "Cette semaine : les langages qui recrutent, un témoignage de développeuse et nos conseils pour réussir un entretien technique. Bonne lecture !", "expected": {"category": "other"}}
{"id": "oth-02", "from_addr": "Maman <maman@famille.example>", "subject": "Dimanche", "body_text": "Coucou, tu viens déjeuner dimanche ? Ton frère sera là. Bisous", "expected": {"category": "other"}}
{"id": "oth-03", "from_addr": "security@github.example", "subject": "A new SSH key was added to your account", "body_text": "Hi, a new public key was added to your account. If you did not do this, please review your security settings.", "expected": {"category": "other"}}
{"id": "oth-04", "from_addr": "facture@operateur-mobile.example", "subject": "Votre facture de septembre est disponible", "body_text": "Bonjour, votre facture d'un montant de 19,99 € est disponible dans votre espace client.", "expected": {"category": "other"}}
{"id": "oth-05", "from_addr": "events@meetup.example", "subject": "Python Lyon : prochain meetup le 14 octobre", "body_text": "Le prochain meetup Python Lyon aura lieu le mercredi 14 octobre à 19 h chez Stratus. Au programme : typage et performance. Inscrivez-vous !", "expected": {"category": "other"}}
{"id": "oth-06", "from_addr": "noreply@linkedin.example", "subject": "Vous apparaissez dans 12 recherches cette semaine", "body_text": "Votre profil a été consulté par des personnes travaillant chez Stratus, Voltéo et 10 autres entreprises. Passez à Premium pour voir qui.", "expected": {"category": "other"}}
{"id": "oth-07", "from_addr": "ecole@insa-lyon.example", "subject": "Soirée des anciens", "body_text": "Chers alumni, la soirée annuelle des anciens aura lieu le 20 novembre. Merci de confirmer votre venue avant le 1er novembre.", "expected": {"category": "other"}}
{"id": "oth-08", "from_addr": "support@pole-emploi.example", "subject": "Actualisation mensuelle", "body_text": "Pensez à vous actualiser avant le 15 du mois pour maintenir vos droits.", "expected": {"category": "other"}}
{"id": "oth-09", "from_addr": "Antoine <antoine.l@ancien-collegue.example>", "subject": "Des nouvelles ?", "body_text": "Salut ! Ça fait longtemps. Je passe à Lyon le mois prochain, on se fait une bière ? J'ai quitté Batiflux au fait.", "expected": {"category": "other"}}
