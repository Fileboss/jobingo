# Copy to evals/.env, then `chmod 600 evals/.env`. evals/.env is gitignored.
# `make eval` reads this file only: never the app's .env, never the shell.

# Required. Prefer a key of its own, with its own spend limit in the Console.
ANTHROPIC_API_KEY=

# Optional: every value below is already the default, the app's own settings.
# A different model or setting writes its own results file, next to the baseline.
LLM_MODEL_FAST=claude-haiku-5-5
LLM_FAST_THINKING=off
LLM_FAST_EFFORT=medium
LLM_MODEL_WRITING=claude-sonnet-5-5
LLM_WRITING_THINKING=off
LLM_WRITING_EFFORT=medium
