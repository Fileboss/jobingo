# Copy to .env and adjust: every value below is already the default.
# .env is gitignored. Real secrets go there, never in this file.

# Local database from docker-compose.yml
DATABASE_URL=postgresql://jobingo:jobingo@127.0.0.1:5433/jobingo

# The account created at startup. Not personal data: pick any identifier.
ACCOUNT_USERNAME=owner

# Claude. Without a key, the app runs and says the AI is not configured.
# ANTHROPIC_API_KEY=
# Starting hypotheses, until an eval measures them.
LLM_MODEL_FAST=claude-haiku-5-5
LLM_FAST_THINKING=off
LLM_FAST_EFFORT=medium
LLM_MODEL_WRITING=claude-sonnet-5-5
LLM_WRITING_THINKING=off
LLM_WRITING_EFFORT=medium
# Caps on what the model may cost per day and per month, in USD, failed calls included.
LLM_DAILY_BUDGET_USD=2
LLM_MONTHLY_BUDGET_USD=30

# Mail. By default the local servers of docker-compose.yml (`make mail-up`): GreenMail
# holds a fictional mailbox read over IMAP, Mailpit keeps what is sent and shows it at
# http://127.0.0.1:8025. Nothing leaves the machine.
MAIL_IMAP_HOST=127.0.0.1
MAIL_IMAP_PORT=3143
MAIL_IMAP_SSL=false
MAIL_IMAP_USER=alex@jobingo.test
MAIL_IMAP_PASSWORD=jobingo
MAIL_INBOX_FOLDER=INBOX
MAIL_ALERT_FOLDER=INBOX
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SSL=false
MAIL_FROM=alex@jobingo.test
# Nothing is sent while this is on, whatever the server. Turn it off to send.
SMTP_DRY_RUN=true

# Your real Gmail instead: put these in .env, not here. Use a mailbox dedicated to the
# job search, with 2-step verification and an app password
# (https://myaccount.google.com/apppasswords), never your account password.
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_SSL=true
# MAIL_IMAP_USER=you@gmail.com
# MAIL_IMAP_PASSWORD=your-app-password
# MAIL_ALERT_FOLDER=Alertes-emploi
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SSL=true
# MAIL_SMTP_USER=you@gmail.com
# MAIL_SMTP_PASSWORD=your-app-password
# MAIL_FROM=you@gmail.com
