# Copy to .env and adjust: every value below is already the default.
# .env is gitignored. Real secrets go there, never in this file.

# Local database from docker-compose.yml
DATABASE_URL=postgresql://jobingo:jobingo@127.0.0.1:5433/jobingo

# The account created at startup. Not personal data: pick any identifier.
ACCOUNT_USERNAME=owner

# Claude. Without a key, the app runs and says the AI is not configured.
# ANTHROPIC_API_KEY=
# Starting hypotheses, until an eval measures them.
LLM_MODEL_FAST=claude-haiku-5-5
LLM_FAST_THINKING=off
LLM_FAST_EFFORT=medium
LLM_MODEL_WRITING=claude-sonnet-5-5
LLM_WRITING_THINKING=off
LLM_WRITING_EFFORT=medium
# Caps on what the model may cost per day and per month, in USD, failed calls included.
LLM_DAILY_BUDGET_USD=2
LLM_MONTHLY_BUDGET_USD=30
