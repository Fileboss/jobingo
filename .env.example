# Copy to .env (gitignored) and fill in. Real secrets go there, never in this file.
# Every uncommented value below is already the default: keep or change it. A commented
# line is one to uncomment and fill in. Restart the API after changing .env.

# --- Database ------------------------------------------------------------------------

# Local database from docker-compose.yml (`make db-up`).
DATABASE_URL=postgresql://jobingo:jobingo@127.0.0.1:5433/jobingo

# The account created at startup. Not personal data: pick any identifier.
ACCOUNT_USERNAME=owner

# --- Claude ----------------------------------------------------------------------------

# Your Anthropic API key. Without it the app runs, and the AI features say they are
# not configured.
# ANTHROPIC_API_KEY=sk-ant-...

# Starting hypotheses, until an eval measures them.
LLM_MODEL_FAST=claude-haiku-5-5
LLM_FAST_THINKING=off
LLM_FAST_EFFORT=medium
LLM_MODEL_WRITING=claude-sonnet-5-5
LLM_WRITING_THINKING=off
LLM_WRITING_EFFORT=medium
# Caps on what the model may cost per day and per month, in USD, failed calls included.
LLM_DAILY_BUDGET_USD=2
LLM_MONTHLY_BUDGET_USD=30

# --- Sending ---------------------------------------------------------------------------

# Nothing is sent while this is on, whatever the server: an approved message is built
# and kept, nothing leaves. Set it to false to really send.
SMTP_DRY_RUN=true

# --- Mailbox: your real Gmail ------------------------------------------------------------

# Uncomment the whole block and fill it in. Use a mailbox dedicated to the job search,
# with 2-step verification and an app password (https://myaccount.google.com/apppasswords),
# never your account password. The same address and app password serve both servers.
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_SSL=true
# MAIL_IMAP_USER=you@gmail.com
# MAIL_IMAP_PASSWORD=your-app-password
# MAIL_INBOX_FOLDER=INBOX
# The Gmail label a filter moves job alerts to. Without one, leave INBOX: alerts from
# other senders than LinkedIn are then hidden as newsletters until you restore them.
# MAIL_ALERT_FOLDER=Alertes-emploi
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SSL=true
# MAIL_SMTP_USER=you@gmail.com
# MAIL_SMTP_PASSWORD=your-app-password
# MAIL_FROM=you@gmail.com

# --- Mailbox: the local servers (the default) ------------------------------------------

# Without the Gmail block, the app uses the local servers of docker-compose.yml
# (`make mail-up`): GreenMail holds a fictional mailbox read over IMAP, Mailpit keeps
# what is sent and shows it at http://127.0.0.1:8025. Nothing leaves the machine.
# These are the defaults, listed for reference: nothing to set.
# MAIL_IMAP_HOST=127.0.0.1
# MAIL_IMAP_PORT=3143
# MAIL_IMAP_SSL=false
# MAIL_IMAP_USER=alex@jobingo.test
# MAIL_IMAP_PASSWORD=jobingo
# MAIL_INBOX_FOLDER=INBOX
# MAIL_ALERT_FOLDER=INBOX
# MAIL_SMTP_HOST=127.0.0.1
# MAIL_SMTP_PORT=1025
# MAIL_SMTP_SSL=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM=alex@jobingo.test
